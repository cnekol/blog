{
  "$schema": "node_modules/wrangler/config-schema.json",
  // neko.icu：纯静态资源 Worker，无脚本
  "name": "neko-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "neko.icu", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  // Worker Previews（非 main 分支的预览构建）要求有这个块；纯静态站没有变量和绑定，留空
  "previews": {}
}
