---
import { email, sites } from '@neko/design/sites'
import { Image } from 'astro:assets'
import WorkLayout from '~/layouts/WorkLayout.astro'
import { getProjects } from '~/lib/work'

const projects = await getProjects()
---

<WorkLayout title="Neko · 设计" description="Neko 的设计作品与案例">
  {
    projects.length === 0 ? (
      <section class="placeholder">
        <p class="lede">我是 Neko，产品设计师。</p>
        <p>作品集正在整理，很快上线。</p>
        <p>
          合作或交流：<a href={`mailto:${email}`}>{email}</a>
        </p>
        <p>
          写作与生活在 <a href={sites.site.url}>neko.icu</a>。
        </p>
      </section>
    ) : (
      <>
        <p class="lede">我是 Neko，产品设计师。这里是我做过的一些项目。</p>
        <ul class="grid">
          {projects.map((project) => (
            <li class="card">
              <a href={`/projects/${project.id}/`}>
                <div class="card-media">
                  {project.data.cover && (
                    <Image src={project.data.cover} alt="" widths={[480, 960]} sizes="(min-width: 60rem) 30vw, 100vw" />
                  )}
                </div>
                <h2>{project.data.title}</h2>
                <p>{project.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</WorkLayout>

<style>
  .placeholder {
    min-height: 50vh;
    color: var(--color-muted);
  }
  .placeholder .lede {
    color: var(--color-text);
  }
  .placeholder p {
    margin: 0 0 var(--space-3);
  }
</style>
