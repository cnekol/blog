---
import { author, twitter } from './sites'

export interface Props {
  title: string
  description?: string
  /** 站点名，拼进 <title> 与 og:site_name */
  siteName: string
  /** 绝对地址或站内路径的分享图 */
  image?: string
  type?: 'website' | 'article'
  noindex?: boolean
  /** RSS 地址（站内路径） */
  feed?: string
  publishedTime?: Date
}

const { title, description, siteName, image, type = 'website', noindex = false, feed, publishedTime } = Astro.props
const fullTitle = title === siteName ? title : `${title} · ${siteName}`
const canonical = new URL(Astro.url.pathname, Astro.site)
const imageUrl = image ? new URL(image, Astro.site).toString() : undefined
---

<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
<meta name="author" content={author} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
{feed && <link rel="alternate" type="application/rss+xml" title={siteName} href={new URL(feed, Astro.site)} />}

<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="zh_CN" />
{description && <meta property="og:description" content={description} />}
{imageUrl && <meta property="og:image" content={imageUrl} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:site" content={twitter} />
