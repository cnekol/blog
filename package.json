{
  "name": "neko.icu",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "repository": "https://github.com/cnekol/neko.icu",
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev:site": "pnpm --filter @neko/site dev",
    "dev:work": "pnpm --filter @neko/work dev",
    "build": "pnpm --recursive --filter './apps/*' build",
    "check": "pnpm --recursive --filter './apps/*' check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "astro-eslint-parser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-astro": "catalog:",
    "eslint-plugin-format": "catalog:",
    "lint-staged": "catalog:",
    "prettier-plugin-astro": "catalog:",
    "simple-git-hooks": "catalog:",
    "typescript": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
