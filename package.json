{
  "name": "neko.icu",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.14.4",
  "repository": "https://github.com/cnekol/blog",
  "scripts": {
    "dev:site": "pnpm --filter @neko/site dev",
    "dev:work": "pnpm --filter @neko/work dev",
    "build": "pnpm --recursive --filter './apps/*' build",
    "check": "pnpm --recursive --filter './apps/*' check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.17.0",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.31.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-format": "^1.0.1",
    "lint-staged": "^16.1.2",
    "prettier-plugin-astro": "^0.14.1",
    "simple-git-hooks": "^2.13.0",
    "typescript": "~6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
